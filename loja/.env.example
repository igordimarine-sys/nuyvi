# Copie para .env.local (ignorado pelo Git). Nunca versione valores reais: o repositório é público.

# Conexão PostgreSQL.
# O valor abaixo é SÓ para o Postgres local do docker-compose.yml (porta 5436); não é segredo.
# Preview/Produção: string do Neon (com sslmode=require), configurada na Vercel, nunca aqui.
DATABASE_URL=postgres://loja:loja_dev_local@127.0.0.1:5436/loja

# Better Auth (login da loja). Gere o segredo com: openssl rand -base64 32 (um valor diferente por ambiente; nunca no Git).
BETTER_AUTH_SECRET=
# URL pública da loja: local = http://localhost:3000; produção = a URL https da loja.
BETTER_AUTH_URL=http://localhost:3000
